options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: fmradio
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Not titled yet
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: baseline_chips
  id: variable
  parameters:
    comment: ''
    value: '16'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1264, 252.0]
    rotation: 0
    state: enabled
- name: baseline_len
  id: variable
  parameters:
    comment: ''
    value: ' max(1,int(chip_samples * baseline_chips))'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1392, 252.0]
    rotation: 0
    state: enabled
- name: baseline_scale
  id: variable
  parameters:
    comment: ''
    value: 1.0 / baseline_len
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1264, 316.0]
    rotation: 0
    state: enabled
- name: carrier
