- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "\"\"\"Weak-signal Manchester + Hamming(7,4) decoder for GNU Radio\
      \ Companion.\n\nConnect averaged, non-thresholded RF power directly from Keep\
      \ 1 in N.\nTransmitter format: 16-bit 1010... preamble (Manchester), followed\
      \ by\nHamming(7,4)-protected 16-bit length + payload + CRC-16/CCITT (crc_hqx,\
      \ 0xffff),\nwith all bits Manchester-encoded as 0 -> OFF,ON and 1 -> ON,OFF.\n\
      \nThis block searches for a preamble in the RAW power stream and decodes\nManchester\
      \ bits using the difference of mean received power between chips.\nIt uses a\
      \ soft-decision Hamming decoder to exploit weak-signal confidence.\n\"\"\"\n\
      \nimport binascii\nimport numpy as np\nimport pmt\nfrom gnuradio import gr\n\
      \n\nclass blk(gr.sync_block):\n    PREAMBLE = \"1010101010101010\"\n\n    def\
      \ __init__(\n        self,\n        rx_rate=100.0,\n        chip_time=0.1,\n\
      \        max_payload=1024,\n        guard_time=0.35,\n        preamble_corr_min=0.78,\n\
      \        debug=False,\n    ):\n        gr.sync_block.__init__(\n           \
      \ self,\n            name=\"Weak-Signal Differential Manchester Decoder\",\n\
      \            in_sig=[np.float32],\n            out_sig=[],\n        )\n    \
      \    self.message_port_register_out(pmt.intern(\"out\"))\n\n        self.rx_rate\
      \ = float(rx_rate)\n        self.chip_time = float(chip_time)\n        self.max_payload\
      \ = int(max_payload)\n        self.guard_samples = max(1, int(round(self.rx_rate\
      \ * float(guard_time))))\n        self.preamble_corr_min = float(preamble_corr_min)\n\
      \        self.debug = bool(debug)\n\n        if self.rx_rate <= 0 or self.chip_time\
      \ <= 0:\n            raise ValueError(\"rx_rate and chip_time must both be positive\"\
      )\n        if self.max_payload < 0 or self.max_payload > 65535:\n          \
      \  raise ValueError(\"max_payload must be between 0 and 65535\")\n        if\
      \ not (0.0 < self.preamble_corr_min <= 1.0):\n            raise ValueError(\"\
      preamble_corr_min must be in (0, 1]\")\n\n        exact_chip_samples = self.rx_rate\
      \ * self.chip_time\n        self.chip_samples = int(round(exact_chip_samples))\n\
      \        if self.chip_samples < 5:\n            raise ValueError(\n        \
      \        \"At least 5 receiver samples/chip are needed; increase rx_rate \"\n\
      \                \"or chip_time.\"\n            )\n        if abs(exact_chip_samples\
      \ - self.chip_samples) > 0.01:\n            raise ValueError(\n            \
      \    \"rx_rate * chip_time must be nearly an integer to avoid timing drift.\
      \ \"\n                f\"Got {exact_chip_samples:.5f}.\"\n            )\n\n\
      \        # Integrate over the middle 60% of each chip; exclude transitions.\n\
      \        self.mid_lo = int(np.floor(0.20 * self.chip_samples))\n        self.mid_hi\
      \ = int(np.ceil(0.80 * self.chip_samples))\n        self.mid_width = self.mid_hi\
      \ - self.mid_lo\n        if self.mid_width < 1:\n            raise ValueError(\"\
      Invalid chip integration window\")\n\n        preamble_chips = []\n        for\
      \ bit in self.PREAMBLE:\n            preamble_chips.extend((1, 0) if bit ==\
      \ \"1\" else (0, 1))\n        self.preamble_chips = np.array(preamble_chips,\
      \ dtype=np.int8)\n        self.preamble_signs = (2 * self.preamble_chips - 1).astype(np.float64)\n\
      \        self.preamble_chip_count = len(self.preamble_chips)  # 32\n       \
      \ self.preamble_samples = self.preamble_chip_count * self.chip_samples\n   \
      \     self.chip_offsets = np.arange(self.preamble_chip_count) * self.chip_samples\n\
      \n        # Hamming(7,4): each codeword has 7 transmitted bits.\n        codebook\
      \ = []\n        for v in range(16):\n            d1, d2, d3, d4 = ((v >> 3)\
      \ & 1, (v >> 2) & 1,\n                              (v >> 1) & 1, v & 1)\n \
      \           codebook.append((d1 ^ d2 ^ d4, d1 ^ d3 ^ d4, d1,\n             \
      \                d2 ^ d3 ^ d4, d2, d3, d4))\n        self.codebook = np.array(codebook,\
      \ dtype=np.int8)\n        # With D = second_power - first_power, bit=0 has positive\
      \ D.\n        self.codebook_signs = (1 - 2 * self.codebook).astype(np.float64)\n\
      \n        self.samples = np.empty(0, dtype=np.float64)\n        self.state =\
      \ \"SEARCH\"\n        self.search_next = self.guard_samples\n        self.payload_length\
      \ = None\n        self.preamble_gap = None\n\n        print(\"Weak-signal differential\
      \ Manchester decoder started\", flush=True)\n        print(\n            f\"\
      rx_rate={self.rx_rate:g}, chip_time={self.chip_time:g}, \"\n            f\"\
      samples/chip={self.chip_samples}, \"\n            f\"preamble={self.preamble_chip_count}\
      \ chips, \"\n            f\"guard={self.guard_samples} samples\",\n        \
      \    flush=True,\n        )\n\n    def _chip_averages(self, first_chip, chip_count):\n\
      \        \"\"\"Average the middle 60% of consecutive chips in the buffer.\"\"\
      \"\n        indices = first_chip * self.chip_samples + (\n            np.arange(chip_count,\
      \ dtype=np.int64) * self.chip_samples\n        )\n        start = indices +\
      \ self.mid_lo\n        stop = indices + self.mid_hi\n        sums = np.concatenate(([0.0],\
      \ np.cumsum(self.samples, dtype=np.float64)))\n        return (sums[stop] -\
      \ sums[start]) / self.mid_width\n\n    def _find_preamble(self):\n        \"\
      \"\"Search sample phases, requiring correlation and an OFF guard.\"\"\"\n  \
      \      # Allow one additional chip of lookahead before committing, so the\n\
      \        # chosen alignment can be optimized within its 1-chip neighborhood.\n\
      \        last_ready = len(self.samples) - self.preamble_samples - self.chip_samples\n\
      \        first = max(self.search_next, self.guard_samples)\n        if last_ready\
      \ < first:\n            return False\n\n        # Examine one additional chip\
      \ of candidate phases before accepting\n        # the earliest valid preamble\
      \ start. Without this lookahead, a weak\n        # correlation can lock several\
      \ samples EARLY at a transition.\n        last_evaluable = len(self.samples)\
      \ - self.preamble_samples\n        starts = np.arange(first, last_evaluable\
      \ + 1, dtype=np.int64)\n        cs = np.concatenate(([0.0], np.cumsum(self.samples,\
      \ dtype=np.float64)))\n        chip_starts = starts[:, None] + self.chip_offsets[None,\
      \ :]\n        chip_means = (\n            cs[chip_starts + self.mid_hi] - cs[chip_starts\
      \ + self.mid_lo]\n        ) / self.mid_width\n\n        on_means = chip_means[:,\
      \ self.preamble_chips == 1]\n        off_means = chip_means[:, self.preamble_chips\
      \ == 0]\n        high = on_means.mean(axis=1)\n        low = off_means.mean(axis=1)\n\
      \        gap = high - low\n\n        centered = chip_means - chip_means.mean(axis=1,\
      \ keepdims=True)\n        denom = np.sqrt(\n            np.sum(centered * centered,\
      \ axis=1)\n            * float(self.preamble_chip_count)\n        )\n      \
      \  corr = np.divide(\n            centered @ self.preamble_signs,\n        \
      \    denom,\n            out=np.zeros_like(gap),\n            where=denom >\
      \ 1e-20,\n        )\n\n        # The transmitter sends 1.5 seconds of OFF guard\
      \ before the\n        # preamble. Reject a candidate if that region is not OFF-like.\n\
      \        guard_avg = (\n            cs[starts] - cs[starts - self.guard_samples]\n\
      \        ) / self.guard_samples\n        guard_valid = guard_avg < low + 0.40\
      \ * gap\n\n        # Do not lock onto a partial preamble that starts several\
      \ whole\n        # Manchester bits early in the guard. The repeating 1001...\
      \ pattern\n        # otherwise makes such partial matches score surprisingly\
      \ well.\n        # The first 4 chips must actually resemble ON, OFF, OFF, ON.\n\
      \        midlevel = (high + low) / 2.0\n        preamble_start_valid = (\n \
      \           (chip_means[:, 0] > midlevel)\n            & (chip_means[:, 1] <\
      \ midlevel)\n            & (chip_means[:, 2] < midlevel)\n            & (chip_means[:,\
      \ 3] > midlevel)\n        )\n\n        # A normalized match rejects flat/noise-only\
      \ intervals without any\n        # absolute amplitude threshold (which varies\
      \ with antenna position).\n        valid = (\n            (corr >= self.preamble_corr_min)\
      \ & (gap > 0.0)\n            & guard_valid & preamble_start_valid\n        )\n\
      \        viable = np.flatnonzero(valid)\n        ready = viable[starts[viable]\
      \ <= last_ready]\n        if ready.size == 0:\n            self.search_next\
      \ = int(last_ready) + 1\n            # Retain OFF guard immediately preceding\
      \ any candidate that has\n            # not yet been scanned; bound memory during\
      \ long idle periods.\n            discard = max(0, self.search_next - self.guard_samples)\n\
      \            if discard:\n                self.samples = self.samples[discard:].copy()\n\
      \                self.search_next -= discard\n            return False\n\n \
      \       # Find the best phase near the first plausible frame start, rather\n\
      \        # than accidentally locking to an earlier, partly aligned edge.\n \
      \       first_index = int(ready[0])\n        neighborhood = viable[viable <=\
      \ first_index + self.chip_samples]\n        best = int(neighborhood[np.argmax(corr[neighborhood])])\n\
      \        start = int(starts[best])\n        self.preamble_gap = float(gap[best])\n\
      \n        if self.debug:\n            print(\n                f\"Preamble: corr={corr[best]:.3f},\
      \ \"\n                f\"OFF={low[best]:.4e}, ON={high[best]:.4e}, \"\n    \
      \            f\"gap={self.preamble_gap:.4e}, \"\n                f\"phase={start\
      \ % self.chip_samples}\",\n                flush=True,\n            )\n    \
      \    else:\n            print(f\"Preamble detected (correlation={corr[best]:.3f})\"\
      , flush=True)\n\n        # Buffer now begins with the first preamble chip.\n\
      \        self.samples = self.samples[start:].copy()\n        self.state = \"\
      FRAME\"\n        self.payload_length = None\n        return True\n\n    def\
      \ _differential_bits(self, start_chip, encoded_bit_count):\n        \"\"\"Return\
      \ signed per-bit energy differences (second minus first).\"\"\"\n        mean_power\
      \ = self._chip_averages(start_chip, 2 * encoded_bit_count)\n        return mean_power[1::2]\
      \ - mean_power[0::2]\n\n    def _decode_hamming_soft(self, differences):\n \
      \       \"\"\"ML/soft-decision decoding of Hamming(7,4) using signed energies.\"\
      \"\"\n        if len(differences) % 7:\n            raise ValueError(\"Expected\
      \ groups of 7 encoded Hamming bits\")\n        words = differences.reshape(-1,\
      \ 7)\n        # A codeword gets a positive score when its predicted bit sign\n\
      \        # matches each observed Manchester power difference.\n        scores\
      \ = words @ self.codebook_signs.T\n        choices = np.argmax(scores, axis=1)\n\
      \        # Count changes relative to naive sign-only Manchester decisions.\n\
      \        raw_bits = (words < 0).astype(np.int8)\n        corrections = int(np.count_nonzero(raw_bits\
      \ != self.codebook[choices]))\n        data_bits = \"\".join(f\"{int(v):04b}\"\
      \ for v in choices)\n        return data_bits, corrections\n\n    def _reject(self,\
      \ reason):\n        print(f\"Frame rejected: {reason}\", flush=True)\n     \
      \   # Do not lock endlessly on the same candidate. Keep already-\n        #\
      \ buffered later samples to allow searching for subsequent frames.\n       \
      \ self.samples = self.samples[self.chip_samples:].copy()\n        self.state\
      \ = \"SEARCH\"\n        self.payload_length = None\n        self.search_next\
      \ = self.guard_samples\n\n    def _process_frame(self):\n        # The 16 length\
      \ bits are protected by four Hamming(7,4) words:\n        # 28 encoded bits,\
      \ 56 Manchester chips, after 32 preamble chips.\n        header_chips = self.preamble_chip_count\
      \ + 2 * 28\n        if len(self.samples) < header_chips * self.chip_samples:\n\
      \            return False\n\n        if self.payload_length is None:\n     \
      \       d = self._differential_bits(self.preamble_chip_count, 28)\n        \
      \    header_bits, _ = self._decode_hamming_soft(d)\n            length = int(header_bits,\
      \ 2)\n            if length > self.max_payload:\n                self._reject(f\"\
      invalid payload length {length} (max={self.max_payload})\")\n              \
      \  return True\n            self.payload_length = length\n            if self.debug:\n\
      \                print(f\"Payload length: {length} bytes\", flush=True)\n\n\
      \        # Protected body = 16-bit length + payload + 16-bit CRC.\n        data_bits\
      \ = 32 + 8 * self.payload_length\n        coded_bits = (data_bits // 4) * 7\n\
      \        total_chips = self.preamble_chip_count + 2 * coded_bits\n        needed\
      \ = total_chips * self.chip_samples\n        if len(self.samples) < needed:\n\
      \            return False\n\n        differences = self._differential_bits(self.preamble_chip_count,\
      \ coded_bits)\n        recovered, corrections = self._decode_hamming_soft(differences)\n\
      \        length = int(recovered[:16], 2)\n        if length != self.payload_length:\n\
      \            self._reject(\"header length mismatch\")\n            return True\n\
      \n        payload_bits = recovered[16:16 + 8 * length]\n        received_crc\
      \ = int(recovered[16 + 8 * length:32 + 8 * length], 2)\n        payload = bytes(\n\
      \            int(payload_bits[i:i + 8], 2)\n            for i in range(0, len(payload_bits),\
      \ 8)\n        )\n        calculated_crc = binascii.crc_hqx(payload, 0xFFFF)\n\
      \        if received_crc != calculated_crc:\n            self._reject(\n   \
      \             f\"CRC mismatch (received 0x{received_crc:04x}, \"\n         \
      \       f\"calculated 0x{calculated_crc:04x})\"\n            )\n           \
      \ return True\n\n        try:\n            message = payload.decode(\"utf-8\"\
      )\n        except UnicodeDecodeError:\n            self._reject(\"valid CRC\
      \ but invalid UTF-8 payload\")\n            return True\n\n        print(\n\
      \            f\"DECODED MESSAGE: {message!r} \"\n            f\"(soft-Hamming\
      \ corrections={corrections})\",\n            flush=True,\n        )\n      \
      \  self.message_port_pub(pmt.intern(\"out\"), pmt.to_pmt(message))\n\n     \
      \   # Drop only the decoded frame, leaving any subsequent OFF guard\n      \
      \  # and new transmission in the stream.\n        self.samples = self.samples[needed:].copy()\n\
      \        self.state = \"SEARCH\"\n        self.payload_length = None\n     \
      \   self.search_next = self.guard_samples\n        return True\n\n    def work(self,\
      \ input_items, output_items):\n        x = input_items[0]\n        if len(x)\
      \ == 0:\n            return 0\n        self.samples = np.concatenate((self.samples,\
      \ np.asarray(x, dtype=np.float64)))\n\n        # Process data in chunks, not\
      \ one Python iteration per SDR sample.\n        # The loop may decode multiple\
      \ frames if they arrived in one chunk.\n        for _ in range(20):\n      \
      \      if self.state == \"SEARCH\":\n                if not self._find_preamble():\n\
      \                    break\n            elif self.state == \"FRAME\":\n    \
      \            if not self._process_frame():\n                    break\n    \
      \        else:\n                raise RuntimeError(f\"Unexpected decoder state:\
      \ {self.state}\")\n        return len(x)\n"
    affinity: ''
    alias: ''
    chip_time: chip_time
    comment: ''
    debug: 'True'
    guard_time: '0.35'
    max_payload: '1024'
    maxoutbuf: '0'
    minoutbuf: '0'
    preamble_corr_min: '0.78'
    rx_rate: rx_rate
  states:
    _io_cache: ('Weak-Signal Differential Manchester Decoder', 'blk', [('rx_rate',
