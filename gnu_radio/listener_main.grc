- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport pmt\nimport\
      \ binascii\n\n\nclass blk(gr.sync_block):\n\n    PREAMBLE = \"1010101010101010\"\
      \n\n    def __init__(\n        self,\n        rx_rate=400.0,\n        chip_time=0.25,\n\
      \        min_silence_time=0.50,\n        first_center_fraction=0.40,\n     \
      \   max_payload=1024,\n        debug_chips=True\n    ):\n\n        gr.sync_block.__init__(\n\
      \            self,\n            name=\"Manchester Hamming74 Frame Decoder\"\
      ,\n            in_sig=[np.float32],\n            out_sig=[]\n        )\n\n \
      \       # ====================================================\n        # Timing\
      \ configuration\n        # ====================================================\n\
      \n        self.rx_rate = float(rx_rate)\n        self.chip_time = float(chip_time)\n\
      \n        self.chip_samples = max(\n            4,\n            int(\n     \
      \           round(\n                    self.rx_rate\n                    *\
      \ self.chip_time\n                )\n            )\n        )\n\n        # Frame\
      \ must be preceded by this much OFF time.\n        self.min_silence_samples\
      \ = max(\n            1,\n            int(\n                self.rx_rate\n \
      \               * min_silence_time\n            )\n        )\n\n        # The\
      \ slicer has a small debounce delay.\n        #\n        # After observing the\
      \ first rising edge, wait this\n        # fraction of a chip so we sample near\
      \ the center\n        # of the first HIGH Manchester chip.\n        self.first_center_delay\
      \ = max(\n            1,\n            int(\n                self.chip_samples\n\
      \                * float(first_center_fraction)\n            )\n        )\n\n\
      \        self.max_payload = int(\n            max_payload\n        )\n\n   \
      \     self.debug_chips = bool(\n            debug_chips\n        )\n\n\n   \
      \     # ====================================================\n        # Message\
      \ output\n        # ====================================================\n\n\
      \        self.message_port_register_out(\n            pmt.intern(\"out\")\n\
      \        )\n\n\n        # ====================================================\n\
      \        # Build Hamming(7,4) codebook\n        # ====================================================\n\
      \n        self.codebook = []\n\n        for value in range(16):\n\n        \
      \    data = [\n                (value >> 3) & 1,\n                (value >>\
      \ 2) & 1,\n                (value >> 1) & 1,\n                value & 1\n  \
      \          ]\n\n            codeword = self.hamming_encode(\n              \
      \  data\n            )\n\n            self.codebook.append(\n              \
      \  (\n                    data,\n                    codeword\n            \
      \    )\n            )\n\n\n        print(\n            \"Manchester + Hamming(7,4)\
      \ decoder started\",\n            flush=True\n        )\n\n        print(\n\
      \            \"rx_rate:\",\n            self.rx_rate,\n            flush=True\n\
      \        )\n\n        print(\n            \"chip_time:\",\n            self.chip_time,\n\
      \            flush=True\n        )\n\n        print(\n            \"samples/chip:\"\
      ,\n            self.chip_samples,\n            flush=True\n        )\n\n   \
      \     print(\n            \"minimum silence samples:\",\n            self.min_silence_samples,\n\
      \            flush=True\n        )\n\n        print(\n            \"first center\
      \ delay:\",\n            self.first_center_delay,\n            flush=True\n\
      \        )\n\n\n        self.reset()\n\n\n    # ========================================================\n\
      \    # Hamming(7,4) encoder\n    #\n    # Used to construct the decoder codebook.\n\
      \    # ========================================================\n\n    def hamming_encode(\n\
      \        self,\n        data\n    ):\n\n        d1, d2, d3, d4 = data\n\n  \
      \      # Hamming positions:\n        #\n        # 1 = p1\n        # 2 = p2\n\
      \        # 3 = d1\n        # 4 = p4\n        # 5 = d2\n        # 6 = d3\n  \
      \      # 7 = d4\n\n        p1 = (\n            d1\n            ^ d2\n      \
      \      ^ d4\n        )\n\n        p2 = (\n            d1\n            ^ d3\n\
      \            ^ d4\n        )\n\n        p4 = (\n            d2\n           \
      \ ^ d3\n            ^ d4\n        )\n\n        return [\n            p1,\n \
      \           p2,\n            d1,\n            p4,\n            d2,\n       \
      \     d3,\n            d4\n        ]\n\n\n    # ========================================================\n\
      \    # Hamming(7,4) decoder\n    # ========================================================\n\
      \n    def hamming_decode(\n        self,\n        received\n    ):\n\n     \
      \   \"\"\"\n        received contains seven values:\n\n            0\n     \
      \       1\n            None\n\n        None represents a Manchester erasure.\n\
      \n        We compare against all 16 valid Hamming codewords and\n        choose\
      \ the unique nearest codeword.\n        \"\"\"\n\n        erasures = sum(\n\
      \            bit is None\n            for bit in received\n        )\n\n   \
      \     candidates = []\n\n        for data, codeword in self.codebook:\n\n  \
      \          errors = 0\n\n            for r, c in zip(\n                received,\n\
      \                codeword\n            ):\n\n                if r is None:\n\
      \                    continue\n\n                if r != c:\n              \
      \      errors += 1\n\n\n            candidates.append(\n                (\n\
      \                    errors,\n                    data,\n                  \
      \  codeword\n                )\n            )\n\n\n        minimum = min(\n\
      \            item[0]\n            for item in candidates\n        )\n\n\n  \
      \      best = [\n            item\n            for item in candidates\n    \
      \        if item[0] == minimum\n        ]\n\n\n        # More than one equally-good\
      \ codeword means the result\n        # is ambiguous.\n        if len(best) !=\
      \ 1:\n\n            return None\n\n\n        errors, data, codeword = best[0]\n\
      \n\n        # Hamming(7,4) has distance 3.\n        #\n        # Guaranteed\
      \ correction condition:\n        #\n        #     2(errors) + erasures < 3\n\
      \n        if (\n            erasures > 0\n            and\n            (\n \
      \               2 * errors\n                + erasures\n            ) >= 3\n\
      \        ):\n\n            return None\n\n\n        corrected = (\n        \
      \    errors > 0\n            or\n            erasures > 0\n        )\n\n\n \
      \       return {\n            \"data\": data,\n            \"codeword\": codeword,\n\
      \            \"errors\": errors,\n            \"erasures\": erasures,\n    \
      \        \"corrected\": corrected\n        }\n\n\n    # ========================================================\n\
      \    # Reset receiver\n    # ========================================================\n\
      \n    def reset(self):\n\n        # --------------------------------------------\n\
      \        # Physical/frame synchronization\n        # --------------------------------------------\n\
      \n        self.state = \"WAIT\"\n\n        self.silence_count = 0\n\n      \
      \  # Counts down to next chip-center sample.\n        self.center_count = 0\n\
      \n\n        # --------------------------------------------\n        # Manchester\
      \ decoder\n        # --------------------------------------------\n\n      \
      \  self.chip_pair = []\n\n\n        # --------------------------------------------\n\
      \        # Protocol decoder\n        # --------------------------------------------\n\
      \n        self.stage = \"PREAMBLE\"\n\n        self.preamble_bits = \"\"\n\n\
      \        self.hamming_buffer = []\n\n        self.length_bits = \"\"\n\n   \
      \     self.payload_bits = \"\"\n\n        self.crc_bits = \"\"\n\n        self.payload_length\
      \ = 0\n\n\n        # --------------------------------------------\n        #\
      \ Statistics\n        # --------------------------------------------\n\n   \
      \     self.corrected_words = 0\n\n        self.uncorrectable_words = 0\n\n\n\
      \    # ========================================================\n    # Process\
      \ one Manchester chip\n    # ========================================================\n\
      \n    def process_chip(\n        self,\n        chip\n    ):\n\n        self.chip_pair.append(\n\
      \            chip\n        )\n\n\n        if len(self.chip_pair) < 2:\n\n  \
      \          return\n\n\n        first = self.chip_pair[0]\n\n        second =\
      \ self.chip_pair[1]\n\n        self.chip_pair = []\n\n\n        # ====================================================\n\
      \        # Manchester decoding\n        #\n        # 0 -> 01\n        # 1 ->\
      \ 10\n        # ====================================================\n\n   \
      \     if (\n            first == 0\n            and\n            second == 1\n\
      \        ):\n\n            bit = 0\n\n\n        elif (\n            first ==\
      \ 1\n            and\n            second == 0\n        ):\n\n            bit\
      \ = 1\n\n\n        else:\n\n            print(\n                \"Manchester\
      \ erasure:\",\n                first,\n                second,\n           \
      \     flush=True\n            )\n\n\n            # The preamble is not protected\
      \ by Hamming.\n            # If synchronization is wrong during the preamble,\n\
      \            # restart frame acquisition.\n            if self.stage == \"PREAMBLE\"\
      :\n\n                print(\n                    \"Lost synchronization during\
      \ preamble\",\n                    flush=True\n                )\n\n       \
      \         self.reset()\n\n                return\n\n\n            # Inside Hamming-protected\
      \ data, preserve the bit\n            # position by inserting an erasure.\n\
      \            bit = None\n\n\n        # ====================================================\n\
      \        # Preamble\n        # ====================================================\n\
      \n        if self.stage == \"PREAMBLE\":\n\n            self.process_preamble_bit(\n\
      \                bit\n            )\n\n            return\n\n\n        # ====================================================\n\
      \        # Hamming protected body\n        # ====================================================\n\
      \n        self.process_hamming_bit(\n            bit\n        )\n\n\n    # ========================================================\n\
      \    # Process preamble bit\n    # ========================================================\n\
      \n    def process_preamble_bit(\n        self,\n        bit\n    ):\n\n    \
      \    if bit is None:\n\n            self.reset()\n\n            return\n\n\n\
      \        self.preamble_bits += str(\n            bit\n        )\n\n\n      \
      \  if (\n            len(self.preamble_bits)\n            < len(self.PREAMBLE)\n\
      \        ):\n\n            return\n\n\n        if (\n            self.preamble_bits\n\
      \            != self.PREAMBLE\n        ):\n\n            print(\n          \
      \      \"Bad preamble:\",\n                self.preamble_bits,\n           \
      \     flush=True\n            )\n\n            self.reset()\n\n            return\n\
      \n\n        print(\n            \"Preamble detected\",\n            flush=True\n\
      \        )\n\n\n        self.stage = \"LENGTH\"\n\n        self.hamming_buffer\
      \ = []\n\n\n    # ========================================================\n\
      \    # Process Hamming encoded bit stream\n    # ========================================================\n\
      \n    def process_hamming_bit(\n        self,\n        bit\n    ):\n\n     \
      \   self.hamming_buffer.append(\n            bit\n        )\n\n\n        if\
      \ (\n            len(self.hamming_buffer)\n            < 7\n        ):\n\n \
      \           return\n\n\n        received = list(\n            self.hamming_buffer\n\
      \        )\n\n        self.hamming_buffer = []\n\n\n        result = self.hamming_decode(\n\
      \            received\n        )\n\n\n        if result is None:\n\n       \
      \     print(\n                \"Uncorrectable Hamming codeword:\",\n       \
      \         received,\n                flush=True\n            )\n\n         \
      \   self.uncorrectable_words += 1\n\n            self.reset()\n\n          \
      \  return\n\n\n        if result[\"corrected\"]:\n\n            self.corrected_words\
      \ += 1\n\n            print(\n                \"Hamming corrected:\",\n    \
      \            received,\n                \"->\",\n                result[\"codeword\"\
      ],\n                flush=True\n            )\n\n\n        # One Hamming codeword\
      \ recovers four original bits.\n        for bit_value in result[\"data\"]:\n\
      \n            self.process_body_bit(\n                bit_value\n          \
      \  )\n\n\n    # ========================================================\n \
      \   # Process original data after Hamming correction\n    # ========================================================\n\
      \n    def process_body_bit(\n        self,\n        bit\n    ):\n\n        bit\
      \ = str(\n            bit\n        )\n\n\n        # ====================================================\n\
      \        # LENGTH\n        # ====================================================\n\
      \n        if self.stage == \"LENGTH\":\n\n            self.length_bits += bit\n\
      \n\n            if (\n                len(self.length_bits)\n              \
      \  == 16\n            ):\n\n                self.payload_length = int(\n   \
      \                 self.length_bits,\n                    2\n               \
      \ )\n\n\n                print(\n                    \"Payload length:\",\n\
      \                    self.payload_length,\n                    \"bytes\",\n\
      \                    flush=True\n                )\n\n\n                if (\n\
      \                    self.payload_length\n                    > self.max_payload\n\
      \                ):\n\n                    print(\n                        \"\
      Invalid payload length\",\n                        flush=True\n            \
      \        )\n\n                    self.reset()\n\n                    return\n\
      \n\n                if (\n                    self.payload_length\n        \
      \            == 0\n                ):\n\n                    self.stage = \"\
      CRC\"\n\n                else:\n\n                    self.stage = \"PAYLOAD\"\
      \n\n\n            return\n\n\n        # ====================================================\n\
      \        # PAYLOAD\n        # ====================================================\n\
      \n        if self.stage == \"PAYLOAD\":\n\n            self.payload_bits +=\
      \ bit\n\n\n            required = (\n                self.payload_length\n \
      \               * 8\n            )\n\n\n            if (\n                len(self.payload_bits)\n\
      \                >= required\n            ):\n\n                self.stage =\
      \ \"CRC\"\n\n\n            return\n\n\n        # ====================================================\n\
      \        # CRC\n        # ====================================================\n\
      \n        if self.stage == \"CRC\":\n\n            self.crc_bits += bit\n\n\n\
      \            if (\n                len(self.crc_bits)\n                == 16\n\
      \            ):\n\n                self.finish_frame()\n\n\n            return\n\
      \n\n    # ========================================================\n    # Finish\
      \ frame / verify CRC\n    # ========================================================\n\
      \n    def finish_frame(self):\n\n        payload = bytearray()\n\n\n       \
      \ for i in range(\n            0,\n            len(self.payload_bits),\n   \
      \         8\n        ):\n\n            byte_bits = (\n                self.payload_bits[\n\
      \                    i:i + 8\n                ]\n            )\n\n\n       \
      \     if len(byte_bits) == 8:\n\n                payload.append(\n         \
      \           int(\n                        byte_bits,\n                     \
      \   2\n                    )\n                )\n\n\n        received_crc =\
      \ int(\n            self.crc_bits,\n            2\n        )\n\n\n        calculated_crc\
      \ = (\n            binascii.crc_hqx(\n                payload,\n           \
      \     0xFFFF\n            )\n        )\n\n\n        print(\n            \"Received\
      \ CRC:\",\n            hex(received_crc),\n            flush=True\n        )\n\
      \n        print(\n            \"Calculated CRC:\",\n            hex(calculated_crc),\n\
      \            flush=True\n        )\n\n\n        # ====================================================\n\
      \        # CRC failure\n        # ====================================================\n\
      \n        if (\n            received_crc\n            != calculated_crc\n  \
      \      ):\n\n            print(\n                \"CRC FAILED\",\n         \
      \       flush=True\n            )\n\n            print(\n                \"\
      Hamming corrections:\",\n                self.corrected_words,\n           \
      \     flush=True\n            )\n\n            self.reset()\n\n            return\n\
      \n\n        # ====================================================\n       \
      \ # CRC success\n        # ====================================================\n\
      \n        print(\n            \"CRC OK\",\n            flush=True\n        )\n\
      \n\n        try:\n\n            text = bytes(\n                payload\n   \
      \         ).decode(\n                \"utf-8\"\n            )\n\n\n        except\
      \ UnicodeDecodeError:\n\n            print(\n                \"UTF-8 decoding\
      \ failed\",\n                flush=True\n            )\n\n            self.reset()\n\
      \n            return\n\n\n        print()\n\n        print(\n            \"\
      ==============================\",\n            flush=True\n        )\n\n   \
      \     print(\n            \"DECODED MESSAGE:\",\n            flush=True\n  \
      \      )\n\n        print(\n            text,\n            flush=True\n    \
      \    )\n\n        print(\n            \"Hamming corrections:\",\n          \
      \  self.corrected_words,\n            flush=True\n        )\n\n        print(\n\
      \            \"==============================\",\n            flush=True\n \
      \       )\n\n        print()\n\n\n        self.message_port_pub(\n         \
      \   pmt.intern(\"out\"),\n            pmt.to_pmt(\n                text\n  \
      \          )\n        )\n\n\n        self.reset()\n\n\n    # ========================================================\n\
      \    # GNU Radio work()\n    # ========================================================\n\
      \n    def work(\n        self,\n        input_items,\n        output_items\n\
      \    ):\n\n        x = input_items[0]\n\n\n        for sample in x:\n\n    \
      \        # Slicer outputs approximately 0.0 / 1.0.\n            level = (\n\
      \                1\n                if sample >= 0.5\n                else 0\n\
      \            )\n\n\n            # =================================================\n\
      \            # STATE: WAIT\n            #\n            # Wait for a long OFF\
      \ period followed by the first\n            # rising edge of the Manchester\
      \ frame.\n            # =================================================\n\n\
      \            if self.state == \"WAIT\":\n\n                if level == 0:\n\n\
      \                    self.silence_count += 1\n\n\n                else:\n\n\
      \                    # Rising edge after sufficient OFF guard.\n           \
      \         if (\n                        self.silence_count\n               \
      \         >= self.min_silence_samples\n                    ):\n\n          \
      \              print(\n                            \"Frame start detected\"\
      ,\n                            flush=True\n                        )\n\n\n \
      \                       self.state = \"RECEIVE\"\n\n\n                     \
      \   # -------------------------------------\n                        # We're\
      \ near the beginning of the\n                        # first HIGH chip.\n  \
      \                      #\n                        # Wait until near its center.\n\
      \                        # -------------------------------------\n\n       \
      \                 self.center_count = (\n                            self.first_center_delay\n\
      \                        )\n\n\n                    else:\n\n              \
      \          # Not enough preceding silence.\n                        self.silence_count\
      \ = 0\n\n\n            # =================================================\n\
      \            # STATE: RECEIVE\n            #\n            # Sample one value\
      \ near the center of every\n            # Manchester chip.\n            # =================================================\n\
      \n            elif self.state == \"RECEIVE\":\n\n                self.center_count\
      \ -= 1\n\n\n                if (\n                    self.center_count\n  \
      \                  <= 0\n                ):\n\n                    chip = level\n\
      \n\n                    if self.debug_chips:\n\n                        print(\n\
      \                            \"chip:\",\n                            chip,\n\
      \                            flush=True\n                        )\n\n\n   \
      \                 self.process_chip(\n                        chip\n       \
      \             )\n\n\n                    # -----------------------------------------\n\
      \                    # Next chip center is exactly one chip\n              \
      \      # duration later.\n                    # -----------------------------------------\n\
      \n                    self.center_count = (\n                        self.chip_samples\n\
      \                    )\n\n\n        return len(x)"
    affinity: ''
    alias: ''
    chip_time: chip_time
    comment: ''
    debug_chips: 'True'
    first_center_fraction: '0.4'
    max_payload: '1024'
    maxoutbuf: '0'
    min_silence_time: '0.5'
    minoutbuf: '0'
    rx_rate: rx_rate
  states:
    _io_cache: ('Manchester Hamming74 Frame Decoder', 'blk', [('rx_rate', '400.0'),
      ('chip_time', '0.25'), ('min_silence_time', '0.5'), ('first_center_fraction',
      '0.4'), ('max_payload', '1024'), ('debug_chips', 'True')], [('0', 'float', 1)],
      [('out', 'message', 1)], '', ['chip_time', 'debug_chips', 'max_payload', 'rx_rate'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [912, 500.0]
    rotation: 0
    state: enabled
- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n\
      \n    def __init__(\n        self,\n        rx_rate=400.0,\n        chip_time=0.25,\n\
      \        cal_off_time=1.0,\n        on_detect_time=0.50,\n        on_verify_time=1.00,\n\
      \        guard_confirm_time=0.40,\n        end_idle_time=3.0\n    ):\n\n   \
      \     gr.sync_block.__init__(\n            self,\n            name=\"Adaptive\
      \ OOK Slicer\",\n            in_sig=[np.float32],\n            out_sig=[np.float32]\n\
      \        )\n\n        self.rx_rate = float(rx_rate)\n        self.chip_time\
      \ = float(chip_time)\n\n        # A threshold crossing must persist for 10%\
      \ of a chip\n        # before the digital state changes.\n        self.transition_samples\
      \ = max(\n            2,\n            int(\n                self.rx_rate\n \
      \               * self.chip_time\n                * 0.10\n            )\n  \
      \      )\n\n        print(\n            \"Transition confirmation samples:\"\
      ,\n            self.transition_samples,\n            flush=True\n        )\n\
      \        # ====================================================\n        # Convert\
      \ durations to samples\n        # ====================================================\n\
      \n        # How much idle/OFF data to use to determine LOW.\n        self.off_samples_needed\
      \ = max(\n            1,\n            int(self.rx_rate * cal_off_time)\n   \
      \     )\n\n        # Sliding window used to initially identify carrier ON.\n\
      \        self.on_detect_samples = max(\n            1,\n            int(self.rx_rate\
      \ * on_detect_time)\n        )\n\n        # Total sustained ON duration required\
      \ before\n        # accepting the HIGH calibration.\n        self.on_verify_samples\
      \ = max(\n            1,\n            int(self.rx_rate * on_verify_time)\n \
      \       )\n\n        # Amount of sustained OFF required after calibration\n\
      \        # before enabling the output.\n        self.guard_confirm_samples =\
      \ max(\n            1,\n            int(self.rx_rate * guard_confirm_time)\n\
      \        )\n\n        # Amount of sustained OFF used to determine that the\n\
      \        # frame has ended.\n        self.end_idle_samples = max(\n        \
      \    1,\n            int(self.rx_rate * end_idle_time)\n        )\n\n      \
      \  print(\n            \"Adaptive OOK slicer started\",\n            flush=True\n\
      \        )\n\n        print(\n            \"rx_rate:\",\n            self.rx_rate,\n\
      \            flush=True\n        )\n\n        print(\n            \"OFF calibration\
      \ samples:\",\n            self.off_samples_needed,\n            flush=True\n\
      \        )\n\n        print(\n            \"ON detect samples:\",\n        \
      \    self.on_detect_samples,\n            flush=True\n        )\n\n        print(\n\
      \            \"ON verify samples:\",\n            self.on_verify_samples,\n\
      \            flush=True\n        )\n\n        print(\n            \"Guard samples:\"\
      ,\n            self.guard_confirm_samples,\n            flush=True\n       \
      \ )\n\n        self.reset()\n\n\n    # ========================================================\n\
      \    # Reset state machine\n    # ========================================================\n\
      \n    def reset(self):\n\n        self.state = \"CAL_OFF\"\n\n        self.rise_count\
      \ = 0\n        self.fall_count = 0\n        self.off_buffer = []\n        self.detect_buffer\
      \ = []\n        self.on_buffer = []\n        self.guard_buffer = []\n      \
      \  self.low_level = None\n        self.high_level = None\n        self.low_noise\
      \ = None\n        self.on_detection_threshold = None\n        self.threshold_low\
      \ = None\n        self.threshold_high = None\n\n        self.output_state =\
      \ 0\n\n        self.guard_count = 0\n        self.idle_count = 0\n\n       \
      \ self.false_on_count = 0\n\n\n    # ========================================================\n\
      \    # GNU Radio work function\n    # ========================================================\n\
      \n    def work(\n        self,\n        input_items,\n        output_items\n\
      \    ):\n\n        x = input_items[0]\n        y = output_items[0]\n\n     \
      \   for i, sample in enumerate(x):\n\n            value = float(sample)\n\n\n\
      \            # =================================================\n         \
      \   # STATE 1\n            #\n            # Measure carrier-OFF level\n    \
      \        # =================================================\n\n           \
      \ if self.state == \"CAL_OFF\":\n\n                # Never expose calibration\
      \ to decoder.\n                y[i] = 0.0\n\n                self.off_buffer.append(\n\
      \                    value\n                )\n\n                if (\n    \
      \                len(self.off_buffer)\n                    >= self.off_samples_needed\n\
      \                ):\n\n                    n = len(\n                      \
      \  self.off_buffer\n                    )\n\n                    # Ignore first\
      \ and last 10%.\n                    lo = int(\n                        0.10\
      \ * n\n                    )\n\n                    hi = int(\n            \
      \            0.90 * n\n                    )\n\n                    middle =\
      \ np.asarray(\n                        self.off_buffer[lo:hi],\n           \
      \             dtype=np.float64\n                    )\n\n\n                \
      \    # -----------------------------------------\n                    # Robust\
      \ estimate of LOW\n                    # -----------------------------------------\n\
      \n                    median = float(\n                        np.median(middle)\n\
      \                    )\n\n                    mad = float(\n               \
      \         np.median(\n                            np.abs(\n                \
      \                middle - median\n                            )\n          \
      \              )\n                    )\n\n                    self.low_level\
      \ = median\n\n                    # Convert MAD to approximate standard\n  \
      \                  # deviation.\n                    self.low_noise = (\n  \
      \                      1.4826 * mad\n                    )\n               \
      \     self.on_detection_threshold = (\n                        self.low_level\n\
      \                        + max(\n                            2.5 * self.low_noise,\n\
      \                            abs(self.low_level) * 0.08\n                  \
      \      )\n                    )\n                    print(\n              \
      \          \"LOW level:\",\n                        self.low_level,\n      \
      \                  \"noise:\",\n                        self.low_noise,\n  \
      \                      flush=True\n                    )\n\n               \
      \     # Freeze LOW and start searching for ON.\n                    self.state\
      \ = \"WAIT_ON\"\n\n                    self.detect_buffer = []\n\n\n       \
      \     # =================================================\n            # STATE\
      \ 2\n            #\n            # Search for sustained increase that may be\
      \ ON\n            # =================================================\n\n  \
      \          elif self.state == \"WAIT_ON\":\n\n                y[i] = 0.0\n\n\
      \                self.detect_buffer.append(value)\n\n                if len(self.detect_buffer)\
      \ > self.on_detect_samples:\n                    self.detect_buffer.pop(0)\n\
      \n                if len(self.detect_buffer) == self.on_detect_samples:\n\n\
      \                    window = np.asarray(\n                        self.detect_buffer,\n\
      \                        dtype=np.float64\n                    )\n\n       \
      \             # Require the MEDIAN of the whole window to rise.\n          \
      \          window_median = float(\n                        np.median(window)\n\
      \                    )\n\n                    # Stronger ON requirement now\
      \ that the antenna\n                    # gives us much better separation.\n\
      \                    rise_needed = max(\n                        2.5 * self.low_noise,\n\
      \                        abs(self.low_level) * 0.08\n                    )\n\
      \n                    rise_threshold = self.on_detection_threshold\n\n     \
      \               if window_median >= rise_threshold:\n\n                    \
      \    print(\n                            \"ON candidate:\",\n              \
      \              \"level =\",\n                            window_median,\n  \
      \                          \"required >=\",\n                            rise_threshold,\n\
      \                            flush=True\n                        )\n\n     \
      \                   self.on_buffer = list(\n                            self.detect_buffer\n\
      \                        )\n\n                        self.state = \"VERIFY_ON\"\
      \n\n\n            # =================================================\n    \
      \        # STATE 3\n            #\n            # Require sustained ON before\
      \ accepting calibration\n            # =================================================\n\
      \n            elif self.state == \"VERIFY_ON\":\n\n                y[i] = 0.0\n\
      \n                self.on_buffer.append(\n                    value\n      \
      \          )\n\n\n                if (\n                    len(self.on_buffer)\n\
      \                    >= self.on_verify_samples\n                ):\n\n     \
      \               on_data = np.asarray(\n                        self.on_buffer,\n\
      \                        dtype=np.float64\n                    )\n\n       \
      \             n = len(\n                        on_data\n                  \
      \  )\n\n                    # Ignore transition edges.\n                   \
      \ lo = int(\n                        0.10 * n\n                    )\n\n   \
      \                 hi = int(\n                        0.90 * n\n            \
      \        )\n\n                    middle = on_data[\n                      \
      \  lo:hi\n                    ]\n\n\n                    candidate_high = float(\n\
      \                        np.median(\n                            middle\n  \
      \                      )\n                    )\n\n\n                    gap\
      \ = (\n                        candidate_high\n                        - self.low_level\n\
      \                    )\n\n\n                    # -----------------------------------------\n\
      \                    # Verification threshold\n                    #\n     \
      \               # More strict than initial detection.\n                    #\
      \ -----------------------------------------\n\n                    required_gap\
      \ = max(\n                        2.0 * self.low_noise,\n                  \
      \      abs(self.low_level) * 0.02\n                    )\n\n\n             \
      \       # -----------------------------------------\n                    # False\
      \ ON candidate\n                    # -----------------------------------------\n\
      \n                    if gap < required_gap:\n\n                        self.false_on_count\
      \ += 1\n\n                        # Don't spam the console.\n              \
      \          # Print first rejection and then every\n                        #\
      \ fifth rejection for diagnostics.\n                        if (\n         \
      \                   self.false_on_count == 1\n                            or\n\
      \                            self.false_on_count % 5 == 0\n                \
      \        ):\n\n                            print(\n                        \
      \        \"ON candidate rejected:\",\n                                \"HIGH\
      \ =\",\n                                candidate_high,\n                  \
      \              \"gap =\",\n                                gap,\n          \
      \                      \"required >=\",\n                                required_gap,\n\
      \                                \"rejections =\",\n                       \
      \         self.false_on_count,\n                                flush=True\n\
      \                            )\n\n\n                        # Do NOT recalibrate\
      \ LOW.\n                        #\n                        # LOW is already\
      \ known.\n                        # Simply continue waiting for the real\n \
      \                       # ON calibration burst.\n                        self.state\
      \ = \"WAIT_ON\"\n\n                        self.detect_buffer = []\n       \
      \                 self.on_buffer = []\n\n                        continue\n\n\
      \n                    # -----------------------------------------\n        \
      \            # Real ON calibration accepted\n                    # -----------------------------------------\n\
      \n                    self.high_level = (\n                        candidate_high\n\
      \                    )\n\n\n                    print(\n                   \
      \     \"ON CALIBRATION VERIFIED\",\n                        flush=True\n   \
      \                 )\n\n                    print(\n                        \"\
      LOW:\",\n                        self.low_level,\n                        flush=True\n\
      \                    )\n\n                    print(\n                     \
      \   \"HIGH:\",\n                        self.high_level,\n                 \
      \       flush=True\n                    )\n\n                    print(\n  \
      \                      \"Signal gap:\",\n                        gap,\n    \
      \                    flush=True\n                    )\n\n\n               \
      \     # -----------------------------------------\n                    # Calculate\
      \ threshold\n                    # -----------------------------------------\n\
      \n                    # Turn ON when signal reaches 40% of the distance\n  \
      \                  # from calibrated LOW to calibrated HIGH.\n             \
      \       self.threshold_high = (\n                        self.low_level\n  \
      \                      + 0.45 * gap\n                    )\n\n             \
      \       # Turn OFF when signal falls below 25% of the\n                    #\
      \ distance from LOW to HIGH.\n                    self.threshold_low = (\n \
      \                       self.low_level\n                        + 0.2 * gap\n\
      \                    )\n\n\n                    print(\n                   \
      \     \"Threshold low:\",\n                        self.threshold_low,\n   \
      \                     flush=True\n                    )\n\n                \
      \    print(\n                        \"Threshold high:\",\n                \
      \        self.threshold_high,\n                        flush=True\n        \
      \            )\n\n\n                    # -----------------------------------------\n\
      \                    # Do NOT activate yet.\n                    #\n       \
      \             # The transmitter is still inside its\n                    # calibration\
      \ ON period.\n                    #\n                    # Wait for the known\
      \ OFF guard.\n                    # -----------------------------------------\n\
      \n                    self.state = \"WAIT_GUARD\"\n\n                    self.guard_count\
      \ = 0\n\n                    self.output_state = 0\n\n                    self.detect_buffer\
      \ = []\n                    self.on_buffer = []\n\n\n            # =================================================\n\
      \            # STATE 4\n            #\n            # Wait for transmitter OFF\
      \ guard\n            # =================================================\n\n\
      \            elif self.state == \"WAIT_GUARD\":\n\n                # Do not\
      \ expose calibration/guard to decoder.\n                y[i] = 0.0\n\n     \
      \           self.guard_buffer.append(value)\n\n                # Keep exactly\
      \ guard_confirm_time worth of samples.\n                if len(self.guard_buffer)\
      \ > self.guard_confirm_samples:\n                    self.guard_buffer.pop(0)\n\
      \n                if len(self.guard_buffer) == self.guard_confirm_samples:\n\
      \n                    guard = np.asarray(\n                        self.guard_buffer,\n\
      \                        dtype=np.float64\n                    )\n\n       \
      \             # What fraction of the guard window looks OFF?\n             \
      \       below_fraction = float(\n                        np.mean(\n        \
      \                    guard <= self.threshold_low\n                        )\n\
      \                    )\n\n                    # Also check median level.\n \
      \                   guard_median = float(\n                        np.median(guard)\n\
      \                    )\n\n                    # Do NOT require every sample\
      \ to be perfect.\n                    #\n                    # Require:\n  \
      \                  #   - at least 80% of samples below threshold_low\n     \
      \               #   - median below threshold_low\n                    if (\n\
      \                        below_fraction >= 0.80\n                        and\n\
      \                        guard_median <= self.threshold_low\n              \
      \      ):\n\n                        print(\n                            \"\
      OFF guard detected\",\n                            \"median =\",\n         \
      \                   guard_median,\n                            \"below =\",\n\
      \                            f\"{below_fraction * 100:.1f}%\",\n           \
      \                 flush=True\n                        )\n\n                \
      \        print(\n                            \"Slicer ACTIVE\",\n          \
      \                  flush=True\n                        )\n\n               \
      \         self.state = \"ACTIVE\"\n\n                        self.output_state\
      \ = 0\n                        self.idle_count = 0\n\n                     \
      \   self.guard_buffer = []\n\n\n            # =================================================\n\
      \            # STATE 5\n            #\n            # Actual OOK data\n     \
      \       # =================================================\n\n            elif\
      \ self.state == \"ACTIVE\":\n\n                # =====================================================\n\
      \                # Currently OFF\n                # =====================================================\n\
      \n                if self.output_state == 0:\n\n                    # Signal\
      \ must stay above HIGH threshold\n                    # for multiple samples\
      \ before changing to ON.\n                    if value >= self.threshold_high:\n\
      \n                        self.rise_count += 1\n\n                    else:\n\
      \n                        self.rise_count = 0\n\n\n                    if self.rise_count\
      \ >= self.transition_samples:\n\n                        self.output_state =\
      \ 1\n\n                        self.rise_count = 0\n                       \
      \ self.fall_count = 0\n\n\n                # =====================================================\n\
      \                # Currently ON\n                # =====================================================\n\
      \n                else:\n\n                    # Signal must stay below LOW\
      \ threshold\n                    # for multiple samples before changing to OFF.\n\
      \                    if value <= self.threshold_low:\n\n                   \
      \     self.fall_count += 1\n\n                    else:\n\n                \
      \        self.fall_count = 0\n\n\n                    if self.fall_count >=\
      \ self.transition_samples:\n\n                        self.output_state = 0\n\
      \n                        self.fall_count = 0\n                        self.rise_count\
      \ = 0\n\n\n                # Output filtered digital state\n               \
      \ y[i] = float(\n                    self.output_state\n                )\n\n\
      \n                # =====================================================\n\
      \                # End-of-frame detection\n                # =====================================================\n\
      \n                if self.output_state == 0:\n\n                    self.idle_count\
      \ += 1\n\n                else:\n\n                    self.idle_count = 0\n\
      \n\n                if self.idle_count >= self.end_idle_samples:\n\n       \
      \             print(\n                        \"End of frame detected\",\n \
      \                       flush=True\n                    )\n\n              \
      \      print(\n                        \"Returning to calibration\",\n     \
      \                   flush=True\n                    )\n\n                  \
      \  self.reset()\n\n\n        return len(x)"
    affinity: ''
    alias: ''
    cal_off_time: '1.0'
    chip_time: chip_time
    comment: ''
    end_idle_time: '3.0'
    guard_confirm_time: '0.4'
    maxoutbuf: '0'
    minoutbuf: '0'
    on_detect_time: '0.5'
    on_verify_time: '1.00'
    rx_rate: rx_rate
  states:
    _io_cache: ('Adaptive OOK Slicer', 'blk', [('rx_rate', '400.0'), ('chip_time',
      '0.25'), ('cal_off_time', '1.0'), ('on_detect_time', '0.5'), ('on_verify_time',
      '1.0'), ('guard_confirm_time', '0.4'), ('end_idle_time', '3.0')], [('0', 'float',
      1)], [('0', 'float', 1)], '', ['chip_time', 'rx_rate'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [488, 468.0]
    rotation: 0
    state: enabled
- name: freq_xlating_fir_filter_xxx_0
  id: freq_xlating_fir_filter_xxx
  parameters:
    affinity: ''
    alias: ''
    center_freq: offset
    comment: ''
    decim: xlate_decim
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
    taps: xlate_taps
    type: ccc
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [368, 316.0]
