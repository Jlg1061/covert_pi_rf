options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: fmradio
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Not titled yet
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: baseline_chips
  id: variable
  parameters:
    comment: ''
    value: '16'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1264, 252.0]
    rotation: 0
    state: enabled
- name: baseline_len
  id: variable
  parameters:
    comment: ''
    value: ' max(1,int(chip_samples * baseline_chips))'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1392, 252.0]
    rotation: 0
    state: enabled
- name: baseline_scale
  id: variable
  parameters:
    comment: ''
    value: 1.0 / baseline_len
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1264, 316.0]
    rotation: 0
    state: enabled
- name: carrier
  id: variable
  parameters:
    comment: ''
    value: 40.68e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [784, 20.0]
    rotation: 0
    state: enabled
- name: chip_samples
  id: variable
  parameters:
    comment: ''
    value: rx_rate * chip_time
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [632, 20.0]
    rotation: 0
    state: enabled
- name: chip_time
  id: variable
  parameters:
    comment: ''
    value: '0.02'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 20.0]
    rotation: 0
    state: enabled
- name: demod_rate
  id: variable
  parameters:
    comment: ''
    value: samp_rate / xlate_decim
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [392, 20.0]
    rotation: 0
    state: enabled
- name: display_chips
  id: variable
  parameters:
    comment: ''
    value: '30'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1264, 404.0]
    rotation: 0
    state: enabled
- name: display_points
  id: variable
  parameters:
    comment: ''
    value: int(chip_samples * display_chips)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1264, 468.0]
    rotation: 0
    state: enabled
- name: keep_n
  id: variable
  parameters:
    comment: ''
    value: max(1, int(demod_rate * chip_time / samples_per_chip))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [552, 20.0]
    rotation: 0
    state: enabled
- name: offset
  id: variable
  parameters:
    comment: ''
    value: 100e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [896, 20.0]
    rotation: 0
    state: enabled
- name: rx_rate
  id: variable
  parameters:
    comment: ''
    value: demod_rate/keep_n
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [552, 92.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: 1e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 84.0]
    rotation: 0
    state: enabled
- name: samples_per_chip
  id: variable
  parameters:
    comment: ''
    value: '100'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [392, 84.0]
    rotation: 0
    state: enabled
- name: smooth_fraction
  id: variable
  parameters:
    comment: ''
    value: '0.1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1048, 124.0]
    rotation: 0
    state: enabled
- name: smooth_len
  id: variable
  parameters:
    comment: ''
    value: max(1,int(demod_rate * chip_time * smooth_fraction))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1192, 124.0]
    rotation: 0
    state: enabled
- name: smooth_scale
  id: variable
  parameters:
    comment: ''
    value: 1.0/smooth_len
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1048, 196.0]
    rotation: 0
    state: enabled
- name: target_freq
  id: variable
  parameters:
    comment: ''
    value: carrier-offset
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [784, 84.0]
    rotation: 0
    state: enabled
- name: xlate_decim
  id: variable
  parameters:
    comment: ''
    value: '10'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 148.0]
    rotation: 0
    state: enabled
- name: xlate_taps
  id: variable
  parameters:
    comment: ''
    value: firdes.low_pass(    1.0,    samp_rate,    10e3,    5e3,    window.WIN_HAMMING)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1256, 12.0]
    rotation: 0
    state: enabled
